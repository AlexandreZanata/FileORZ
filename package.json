{
  "name": "fileorz",
  "private": true,
  "version": "0.0.0",
  "description": "FileORZ fork — Agent Harness + Lefthook quality gates.",
  "scripts": {
    "prepare": "bash scripts/install-hooks.sh || true",
    "verify": "bash scripts/check-quality.sh",
    "check:size": "python3 scripts/check_size_complexity.py --root .",
    "check:lint": "bash scripts/check-lint.sh",
    "check:system": "bash scripts/check-system.sh",
    "check:adr": "python3 scripts/check_adr.py",
    "characterize": "bash scripts/characterize-python.sh",
    "check:i18n": "bash scripts/check-i18n.sh",
    "check:config-keys": "python3 scripts/check_config_key_map.py",
    "check:rust": "bash scripts/check-rust.sh",
    "check:package": "python3 scripts/check_package_linux.py",
    "check:parity": "python3 scripts/check_parity_report.py",
    "package:linux": "bash scripts/package-linux.sh",
    "e2e:linux": "bash scripts/e2e-linux.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
